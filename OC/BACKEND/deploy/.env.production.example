# ============================================================
# OC-Calisthenics — Variables de entorno (produccion)
# Para Render + Supabase
# ============================================================

# Base de datos PostgreSQL (Supabase)
# Copiar la connection string de: Supabase Dashboard > Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres.[TU-PROJECT-REF]:[TU-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# JWT (autenticacion)
# Render genera JWT_SECRET automaticamente con render.yaml
JWT_SECRET=se-genera-automaticamente
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# CORS — URL del frontend en Netlify (sin / al final). Produccion OC Club:
# ALLOWED_ORIGINS=https://oc-club.netlify.app
# Varias URLs separadas por coma (deploy previews, staging, etc.)
ALLOWED_ORIGINS=https://oc-club.netlify.app
