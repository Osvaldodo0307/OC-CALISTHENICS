# ============================================================
# OC-Calisthenics — Variables de entorno (produccion)
# Copiar a BACKEND/.env y llenar los valores reales
# ============================================================

# Base de datos MySQL (local en la VM de Oracle)
DATABASE_URL=mysql+pymysql://ocadmin:TU_PASSWORD_MYSQL@localhost:3306/oc_calisthenics?charset=utf8mb4

# JWT (autenticacion)
# Generar un secreto seguro con: openssl rand -hex 32
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_GENERADO
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# CORS — URL del frontend en Netlify (sin / al final)
ALLOWED_ORIGINS=https://tu-sitio.netlify.app
