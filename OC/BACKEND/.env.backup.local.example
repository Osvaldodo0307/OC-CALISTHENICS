# Copia este archivo a .env.backup.local (no se versiona).
# Connection string de Supabase: Dashboard > Settings > Database > Connection string > URI
# Usar modo "Session" o "Transaction" pooler segun tu red; para pg_dump suele funcionar el puerto 5432 directo.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
