# ==========================================
# APP MOVIL (CAPACITOR)
# ==========================================

# Emulador Android (host machine):
# 10.0.2.2 = localhost del host visto por emulador Android
# VITE_API_URL=http://10.0.2.2:8000

# Simulador iOS (normalmente permite localhost del host en macOS):
# VITE_API_URL=http://localhost:8000

# Dispositivo fisico en misma red local:
# VITE_API_URL=http://192.168.1.100:8000

# Produccion real (obligatorio en release):
# VITE_API_URL=https://tu-backend-oficial.com

VITE_API_URL=http://10.0.2.2:8000
VITE_APP_MODE=app
VITE_APP_VERSION=1.0.0-mobile-dev
