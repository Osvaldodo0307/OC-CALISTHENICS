# ==========================================
# WEB (DESARROLLO LOCAL)
# ==========================================
VITE_API_URL=http://localhost:8000

# Netlify (panel del sitio): VITE_API_URL = URL HTTPS del backend en Render.
# Frontend produccion: https://oc-club.netlify.app

# Modo de experiencia:
# - web: mantiene rutas publicas + privadas
# - app: oculta flujo publico y prioriza login/sistema interno
VITE_APP_MODE=web

# Etiqueta visible de version (opcional)
VITE_APP_VERSION=1.0.0-dev

# Modo admin demo/local (solo desarrollo — ver docs/ADMIN_DEMO_MODE.md)
# Permite entrar como admin y cargar paneles con datos mock sin backend.
# PRODUCCION (Netlify): NO configurar esta variable, o dejarla explicitamente en false.
# Nunca usar VITE_ENABLE_ADMIN_DEMO=true en Netlify Production ni en deploy previews publicos.
VITE_ENABLE_ADMIN_DEMO=false

# Analitica (opcional — ver docs/ANALYTICS_SETUP.md)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_META_PIXEL_ID=
